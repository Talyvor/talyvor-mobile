{
  "expo": {
    "name": "Talyvor",
    "slug": "talyvor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/app-icon-1024.png",
    "scheme": "talyvor",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#060A12",
    "ios": {
      "bundleIdentifier": "com.talyvor.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "com.talyvor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/android-adaptive-foreground-432.png",
        "backgroundImage": "./assets/logo/android-adaptive-background-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Talyvor uses Face ID so that only you can approve what your agents ask for."
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "./plugins/with-android-widget-links",
      "./plugins/with-app-shortcuts",
      "./plugins/with-tls-only",
      "./plugins/with-gradle-network-retries",
      "./plugins/with-widget-symbol",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111216",
          "image": "./assets/logo/talyvor-symbol-on-dark-1024.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TalyvorAgents",
              "displayName": "Agents",
              "description": "Safe to spend, what is waiting for you, and your pinned agents with Pause and Fund.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/agents-widget.tsx"
              },
              "android": {
                "initialLayout": "./src/widgets/agents-widget-android.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Talyvor listens only while you hold the microphone, or after you say “Hey Taly” with the app open."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
